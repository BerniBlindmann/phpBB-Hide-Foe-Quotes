    "version": "1.0.0",
    "time": "2026-09-10",
    "keywords": [
        "phpbb",
        "extension",
        "foes",
        "ignore",
        "quotes"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Ole",
            "username": "HROle",
            "homepage": "hansaforum.de",
            "role": "Administrator"
        }
    ],
    "require": {
        "php": ">=7.2.0",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Hide Foe Quotes",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
